<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);MSB3270</NoWarn>
    <GameData Condition="'$(GameData)' == ''">$(HOME)/Library/Application Support/Steam/steamapps/common/Slay the Spire 2/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_arm64</GameData>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2" HintPath="$(GameData)/sts2.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameData)/0Harmony.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(GameData)/GodotSharp.dll" Private="false" />
    <Reference Include="MultiplayerPeeking" HintPath="../../.godot/mono/temp/bin/Release/MultiplayerPeeking.dll" Private="false" />
  </ItemGroup>
</Project>
